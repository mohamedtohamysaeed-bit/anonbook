# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your dedicated Pinata gateway, e.g. https://your-name.mypinata.cloud/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# WalletConnect Cloud project id (https://cloud.reown.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# NOTE: the Pinata JWT and the Supabase JWT secret are NOT set here.
# They are server-side secrets: `supabase secrets set JWT_SECRET=... PINATA_JWT=...` (see README).
