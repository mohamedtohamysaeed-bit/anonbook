# =====================================================================================================
# PUBLIC variables. Safe in the browser. They are copied INTO the bundle while it is BUILT, so changing
# one needs a new build.
#
#   Local:      put them in .env.local
#   Cloudflare: Workers & Pages -> anonbook -> Settings -> Build -> "Variables and secrets"
#               -> Add -> Type "Text".  This is the BUILD section.
#               NOT the "Variables and secrets" page under Settings that applies at runtime: values added
#               there never reach the build, so the site stays in demo mode.
#               Then: Deployments -> Retry build (or push a commit).
# =====================================================================================================

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=            # "Project URL", e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # the "anon public" key

# https://cloud.reown.com (formerly cloud.walletconnect.com) -> your project -> Project ID.
# Optional: without it only browser wallets and the built-in anonymous wallet work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=    # NEXT_PUBLIC_WC_PROJECT_ID is accepted too

# Optional
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional FALLBACK for photos and video when IPFS is not working. A PUBLIC Supabase Storage bucket.
# Create it with supabase/storage.sql (default name: anonbook-media, change both together).
# Upload order: 1) IPFS through the "pin" Edge Function  2) this bucket  3) demo mode only: browser placeholder.
NEXT_PUBLIC_STORAGE_BUCKET=

# Cloudflare only (a Build variable, not read by the app): Cloudflare defaults to Node 20, dependencies want 22+.
# NODE_VERSION=22

# =====================================================================================================
# SERVER-ONLY secrets. NEVER prefix with NEXT_PUBLIC_, NEVER add to Cloudflare. The app does not read them.
# They live in Supabase:   npx supabase secrets set JWT_SECRET=... PINATA_JWT=...
# =====================================================================================================
# PINATA_JWT                 Pinata API key limited to pinFileToIPFS. Used by the "pin" Edge Function.
#                            A browser cannot keep it secret, so the app never uses it directly.
# JWT_SECRET                 Supabase JWT secret. Used by the "auth" and "pin" Edge Functions.
# SUPABASE_SERVICE_ROLE_KEY  Supabase injects this into Edge Functions by itself. AnonBook's functions do not
#                            use it. It bypasses all row-level security: keep it out of Cloudflare and out of
#                            any NEXT_PUBLIC_ variable.
