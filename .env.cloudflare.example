# Cloudflare dashboard -> Workers & Pages -> anonbook -> Settings -> Build -> Variables and secrets
# These go in BUILD variables (not Runtime variables): NEXT_PUBLIC_* values are inlined into the
# bundle while it is built. After changing any of them, trigger a new build.

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co      # "Project URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                                 # "anon public" key (public by design)

# https://cloud.reown.com -> your project -> Project ID
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional (default shown)
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Recommended (Cloudflare's default is Node 20; dependencies want 22+)
NODE_VERSION=22
# Optional escape hatches if a new unused wallet SDK / optional package breaks the build (comma or space separated):
# EXTRA_STUBBED_PACKAGES=pkg1, pkg2
# EXTRA_MISSING_PACKAGES=pkg3

# Do NOT put these on Cloudflare. They are Supabase secrets:
#   npx supabase secrets set JWT_SECRET=... PINATA_JWT=...
# You do NOT need NO_MINIFY or SKIP_TYPECHECK; scripts/build.mjs handles the minifier crash automatically.
